# Environment Variable Example for Neon PostgreSQL

# Neon Connection String (from console.neon.tech)
# Format: postgresql://user:password@host/database
DATABASE_URL=postgresql://neon_user:your_password_here@ep-xyz123.us-east-1.neon.tech/muller_app

# Alternative connection parameters (if not using URL)
DB_HOST=ep-xyz123.us-east-1.neon.tech
DB_PORT=5432
DB_NAME=muller_app
DB_USER=neon_user
DB_PASSWORD=your_password_here

# Google OAuth Configuration (for login)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Allowed admin emails (3 users max)
ADMIN_EMAILS=jisraelevich@gmail.com,irisnoeliaruiz@gmail.com,admin3@gmail.com

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Secret key for sessions
SECRET_KEY=your_secret_key_here_change_in_production

# Vercel specific
VERCEL_URL=your_app_url.vercel.app
